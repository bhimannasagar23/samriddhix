# SamriddhiX Environment Variables
# Copy this to backend/.env and fill in your keys

PORT=5000

# Get FREE from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_key_here

# No key needed — Open-Meteo is used (free, no signup)
# Weather API is called directly from frontend

# Optional: OpenWeatherMap for extended data
# OPENWEATHER_API_KEY=your_key_here
